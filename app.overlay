/ {
    /* Define friendly button aliases */
    buttons {
        compatible = "gpio-keys";
        btn_mode: btn_mode {
            gpios = <&gpio0 4 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
            label = "Mode Toggle";
        };
        btn_play: btn_play {
            gpios = <&gpio0 5 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
            label = "Play Pause";
        };
        btn_mute: btn_mute {
            gpios = <&gpio0 6 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
            label = "Mute";
        };
    };

    aliases {
        sw-mode = &btn_mode;
        sw-play = &btn_play;
        sw-mute = &btn_mute;
    };

    /* Define ADC channel for the potentiometer */
    zephyr,user {
        io-channels = <&adc0 0>; /* ADC0 channel 0 corresponds to GPIO 1 */
    };
};

&adc0 {
    status = "okay";
    #address-cells = <1>;
    #size-cells = <0>;

    channel@0 {
        reg = <0>;
        zephyr,gain = "ADC_GAIN_1";
        zephyr,reference = "ADC_REF_INTERNAL";
        zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
        zephyr,resolution = <12>;
    };
};